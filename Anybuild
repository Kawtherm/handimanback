load("//anybuild/tools:laravel.bzl", "laravel_build", "laravel_config", "laravel_serve")

config = laravel_config(
    schema = 1,
    commands = {
        "start": "php -S 0.0.0.0:$PORT -t public",
    },
    node_package_manager = "npm",
    node_build_command = "npm install && npm run production && rm -rf node_modules resources/js resources/scss public/scss tests .github package.json package-lock.json webpack.mix.js .npmrc",
    node_version = "24",
    php_framework = "laravel",
    composer_enable = True,
    composer_build_script = "post-update-cmd",
    php_version = "8.3.29",
    php_public_dir = "public",
)

build = laravel_build(config)

laravel_serve(
    config,
    build,
    name = "ejobs",
    build_pre = [
        copy("composer.json", "/app/composer.json"),
        copy("composer.lock", "/app/composer.lock"),
        copy("package.json", "/app/package.json"),
        copy("package-lock.json", "/app/package-lock.json"),
        copy(".npmrc", "/app/.npmrc"),
    ],
)
