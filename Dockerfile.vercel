# ============================================================
#  Laravel on Vercel — Optimized for Speed
# ============================================================
FROM php:8.3-apache

ENV APACHE_DOCUMENT_ROOT=/var/www/html/public \
    COMPOSER_ALLOW_SUPERUSER=1 \
    COMPOSER_NO_INTERACTION=1

# 1. System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
        git unzip curl ca-certificates libz-dev libzip-dev libonig-dev \
        libxml2-dev libpng-dev libjpeg62-turbo-dev libfreetype6-dev \
        libicu-dev libcurl4-openssl-dev libssl-dev libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# 2. PHP extensions & Opcache
RUN docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j"$(nproc)" \
        bcmath exif gd intl mbstring opcache pcntl pdo pdo_mysql zip

RUN echo "opcache.enable=1" >> /usr/local/etc/php/conf.d/opcache.ini && \
    echo "opcache.enable_cli=1" >> /usr/local/etc/php/conf.d/opcache.ini && \
    echo "opcache.memory_consumption=256" >> /usr/local/etc/php/conf.d/opcache.ini && \
    echo "opcache.max_accelerated_files=20000" >> /usr/local/etc/php/conf.d/opcache.ini && \
    echo "opcache.validate_timestamps=0" >> /usr/local/etc/php/conf.d/opcache.ini

# 3. Apache setup
RUN a2enmod rewrite headers \
    && printf '%s\n' \
       '<VirtualHost *:80>' \
       '    ServerName localhost' \
       '    DocumentRoot /var/www/html/public' \
       '    <Directory /var/www/html/public>' \
       '        Options Indexes FollowSymLinks' \
       '        AllowOverride All' \
       '        Require all granted' \
       '        DirectoryIndex index.php index.html' \
       '    </Directory>' \
       '    <FilesMatch "\.php$">' \
       '        SetHandler application/x-httpd-php' \
       '    </FilesMatch>' \
       '    ErrorLog ${APACHE_LOG_DIR}/error.log' \
       '    CustomLog ${APACHE_LOG_DIR}/access.log combined' \
       '</VirtualHost>' \
       > /etc/apache2/sites-available/000-default.conf \
    && a2dissite 000-default 2>/dev/null || true \
    && a2ensite 000-default \
    && printf 'ServerName localhost\n' > /etc/apache2/conf-available/servername.conf \
    && a2enconf servername

# 4. Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
WORKDIR /var/www/html

# 5. Install PHP dependencies
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction --no-progress

# 6. Copy application source
COPY . .

# 7. Build-time package discovery (using a temporary SQLite database)
#    We do NOT run config:cache here — if we did, the cached config
#    would bake in the SQLite settings and break the MySQL runtime.
RUN composer dump-autoload --optimize --no-dev --no-scripts --no-interaction \
    && mkdir -p database \
    && touch database/database.sqlite \
    && DB_CONNECTION=sqlite \
       DB_DATABASE=/var/www/html/database/database.sqlite \
       APP_ENV=production \
       APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA= \
       php artisan package:discover --ansi \
    && rm -f database/database.sqlite \
    && mkdir -p storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache \
    && chmod -R ug+rwX storage bootstrap/cache \
    && rm -rf /var/www/html/.git

# 8. Runtime
EXPOSE 80
CMD ["sh", "-c", "\
  if [ ! -w /var/www/html/storage ] || [ ! -w /var/www/html/bootstrap/cache ]; then \
    mkdir -p /tmp/laravel-storage/framework/{cache/data,sessions,views,testing} \
             /tmp/laravel-storage/logs /tmp/laravel-storage/app/public \
             /tmp/laravel-bootstrap-cache; \
    rm -rf /var/www/html/storage /var/www/html/bootstrap/cache; \
    ln -s /tmp/laravel-storage /var/www/html/storage; \
    ln -s /tmp/laravel-bootstrap-cache /var/www/html/bootstrap/cache; \
    chown -R www-data:www-data /tmp/laravel-storage /tmp/laravel-bootstrap-cache; \
  fi; \
  echo '[boot] caching config with real runtime env vars ...'; \
  php artisan config:cache || echo '[boot] config:cache failed (non-fatal)'; \
  sed -ri \"s/^Listen 80$/Listen ${PORT:-80}/\" /etc/apache2/ports.conf; \
  sed -ri \"s/<VirtualHost \\*:80>/<VirtualHost *:${PORT:-80}>/\" /etc/apache2/sites-available/000-default.conf; \
  exec apache2-foreground \
"]